{
  "name": "humanfirstai-brand-tools",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Generates every asset in brand/ from one definition of the mark and one palette.",
  "license": "MIT",
  "scripts": {
    "build": "node build-all.mjs",
    "contrast": "node ../skill/human-first-ai-brand/scripts/check-contrast.mjs --palette",
    "logo": "node build/logo.mjs",
    "color": "node build/color.mjs",
    "type": "node build/type.mjs",
    "icons": "node build/icons.mjs",
    "graphics": "node build/graphics.mjs",
    "social": "node build/social.mjs",
    "photos": "node build/photos.mjs",
    "narrate": "node build/narrate.mjs",
    "voices": "node build/voices.mjs",
    "phonemes:check": "node check-phonemes.mjs",
    "voice-check": "node ../skill/human-first-ai-brand/scripts/voice-check.mjs",
    "site": "node build/site.mjs",
    "editorial:policy": "node editorial/policy.mjs",
    "editorial:gates": "node editorial/gates.mjs",
    "editorial:init": "node editorial/run.mjs init",
    "editorial:finalise": "node editorial/run.mjs finalise",
    "editorial:pr": "node editorial/run.mjs pr",
    "editorial:list": "node editorial/run.mjs list",
    "editorial:feedback": "node editorial/feedback.mjs",
    "editorial:test": "node editorial/test.mjs"
  },
  "devDependencies": {
    "kokoro-js": "^1.2.1",
    "opentype.js": "^1.3.4",
    "sharp": "^0.34.2",
    "espeak-ng": "^1.0.2",
    "onnxruntime-node": "^1.23.0"
  },
  "dependencies": {
    "espeak-ng": "^1.0.2",
    "kokoro-js": "^1.2.1"
  }
}
